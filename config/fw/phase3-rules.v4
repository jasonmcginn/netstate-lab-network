# The NetState Lab Network: Phase 3 answer key (fw)
# Phase 1's rules, plus HTTPS (443). Telnet is removed on the server itself,
# so it needs no firewall rule here. SSH stays allowed for client-a, but the
# server now accepts only a key, not a password.
# Load it:  docker compose exec fw sh -c "iptables-restore < /lab/config/fw/phase3-rules.v4"
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A FORWARD -m conntrack --ctstate NEW -j NFLOG --nflog-prefix FW-NEW --nflog-group 1
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -i lan -o dmz -p icmp -m icmp --icmp-type 8 -j ACCEPT
-A FORWARD -i lan -o dmz -p tcp -m tcp --dport 80 -j ACCEPT
-A FORWARD -i lan -o dmz -p tcp -m tcp --dport 443 -j ACCEPT
-A FORWARD -s 10.10.10.11/32 -i lan -o dmz -p tcp -m tcp --dport 22 -j ACCEPT
-A FORWARD -j NFLOG --nflog-prefix FW-DROP --nflog-group 1
COMMIT
